{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christmas-letters",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Your own domain. *.workers.dev is unreachable from some networks, and
  // letter links take the host of the page the sender opened. The zone must
  // live in the same Cloudflare account; deploy creates DNS and certificate.
  "routes": [{ "pattern": "cards.example.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "christmas-letters",
      // From `pnpm exec wrangler d1 create christmas-letters` (docs/deploy.md).
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "christmas-letters-audio" },
    // Prerendered-page store for OpenNext's r2IncrementalCache (open-next.config.ts).
    // Not public: only the Worker reads and writes it.
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "christmas-letters-cache" }
  ]
}
