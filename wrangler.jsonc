{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "christmas-letters",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Served on its own subdomain; Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "3dcards.theliang.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "christmas-letters",
      "database_id": "1e9a5c2d-9ebf-4c2a-8538-294bdf4139d5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "AUDIO", "bucket_name": "christmas-letters-audio" },
    // Prerendered-page store for OpenNext's r2IncrementalCache (open-next.config.ts).
    // Not public: only the Worker reads and writes it.
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "christmas-letters-cache" }
  ]
}
